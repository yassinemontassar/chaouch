# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Postgres + pgvector (docker-compose.yml, `uv run tasks.py db-up`). Local only; pick any password.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and hangs ~2 min.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://chaouch:<POSTGRES_PASSWORD>@127.0.0.1:5432/chaouch
